{
  "entities": {
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Official incoming and outgoing document record for LHSE E-Document Management System",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "direction": { "type": "string", "enum": ["INCOMING", "OUTGOING"], "maxLength": 32 },
        "documentNumber": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 200 },
        "documentType": { "type": "string", "maxLength": 200 },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT", "NORMAL"], "maxLength": 32 },
        "purpose": { "type": "string", "enum": ["RESEARCH", "INFORM", "OTHER"], "maxLength": 32 },
        "status": { "type": "string", "maxLength": 64 },
        "currentStepOrder": { "type": "number" },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "direction", "documentNumber", "subject", "status", "currentStepOrder"]
    },
    "SavedSearchItem": {
      "title": "SavedSearchItem",
      "description": "User saved search filter criteria with automatic notification settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "notifyOnMatch": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "userId", "notifyOnMatch", "createdAt"]
    }
  },
  "firestore": {
    "/documents/{docId}": {
      "schema": "DocumentRecord",
      "description": "Collection of official incoming and outgoing documents"
    },
    "/saved_searches/{searchId}": {
      "schema": "SavedSearchItem",
      "description": "Collection of saved search filter presets and notification triggers"
    }
  }
}
